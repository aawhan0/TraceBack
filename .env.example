# Traceback local configuration
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Local LLM configuration
LLM_PROVIDER=ollama
TRACEBACK_MODEL=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
TRACEBACK_OLLAMA_TIMEOUT=60

# Durable investigation history
TRACEBACK_DATABASE_PATH=data/traceback.db
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Optional remote MCP evidence sources (JSON array)
# TRACEBACK_MCP_EVIDENCE_SOURCES=[{"id":"payments","url":"https://example.internal/mcp","tool":"get_incident_evidence"}]
